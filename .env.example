# Copy this file to .env and adjust the values for your environment.

# A long, random, secret string. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me

# Set to False in production.
DEBUG=True

# Comma-separated list of hostnames this site is allowed to serve.
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated list of trusted origins for CSRF (needed behind HTTPS proxies).
CSRF_TRUSTED_ORIGINS=

TIME_ZONE=UTC

# Email — defaults to printing emails to the console for local development.
# For real password-reset emails in production, use an SMTP backend:
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Easy Apply <noreply@easy-apply.app>

# Set to True once the site is served over HTTPS in production.
SECURE_SSL_REDIRECT=False

# DeepSeek API — powers the "Analyze a job post" (jobs app) and
# "Import from resume" (resume app) AI features.
# Get a key at https://platform.deepseek.com/. Leave empty to disable AI
# analysis (both features show a clear error instead of crashing).
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT=60

# How long (seconds) and how much (bytes) the job-post URL fetcher will
# spend/read before giving up.
JOB_FETCH_TIMEOUT=15
JOB_FETCH_MAX_BYTES=2000000

# Largest resume file (bytes) accepted by the "Import from resume" feature.
RESUME_MAX_UPLOAD_BYTES=8000000

# Copy this file to .env and adjust the values for your environment.

# A long, random, secret string. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me

# Set to False in production.
DEBUG=True

# Comma-separated list of hostnames this site is allowed to serve.
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated list of trusted origins for CSRF (needed behind HTTPS proxies).
CSRF_TRUSTED_ORIGINS=

TIME_ZONE=UTC

# Email — defaults to printing emails to the console for local development.
# For real password-reset emails in production, use an SMTP backend:
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Easy Apply <noreply@easy-apply.app>

# Set to True once the site is served over HTTPS in production.
SECURE_SSL_REDIRECT=False

# DeepSeek API — powers the "Analyze a job post" (jobs app) and
# "Import from resume" (resume app) AI features.
# Get a key at https://platform.deepseek.com/. Leave empty to disable AI
# analysis (both features show a clear error instead of crashing).
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT=60

# How long (seconds) and how much (bytes) the job-post URL fetcher will
# spend/read before giving up.
JOB_FETCH_TIMEOUT=15
JOB_FETCH_MAX_BYTES=2000000

# Largest resume file (bytes) accepted by the "Import from resume" feature.
RESUME_MAX_UPLOAD_BYTES=8000000

# Page size for the tailored-resume PDF export: "letter" or "a4".
RESUME_PDF_PAGE_SIZE=letter

# --- Celery / Redis -------------------------------------------------------
# Every AI call (job analysis, resume analysis, matching, resume generation)
# runs in a Celery worker rather than in the request. Redis is REQUIRED in
# production; start a worker with:
#   celery -A config worker -l info --concurrency=2
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Run tasks inline instead of queueing them. Defaults to the value of DEBUG,
# so local development and the test suite work with no broker and no worker.
# MUST be False in production.
CELERY_TASK_ALWAYS_EAGER=

# Hard and soft time limits (seconds) for a single task.
CELERY_TASK_TIME_LIMIT=600
CELERY_TASK_SOFT_TIME_LIMIT=540

# A running AI task with no update for this long is marked failed by
# `manage.py sweep_stuck_ai_tasks` (run it on worker startup).
AI_TASK_STALE_AFTER=3600
# `manage.py prune_ai_tasks` deletes finished task records older than this.
AI_TASK_RETENTION_DAYS=30

# --- Legal entity ---------------------------------------------------------
# Rendered into the pages served by the `legal` app. REPLACE EVERY VALUE
# before going to production — the defaults are visible TODO placeholders.
LEGAL_NAME=
LEGAL_ADDRESS=
LEGAL_EMAIL=
LEGAL_JURISDICTION=
LEGAL_REGISTRATION=
LEGAL_DIRECTOR=
LEGAL_HOST_NAME=
LEGAL_HOST_ADDRESS=
LEGAL_DPO_EMAIL=
